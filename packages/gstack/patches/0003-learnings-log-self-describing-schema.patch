+  if (v.enum) line += " (one of: " + v.enum.join(", ") + ")";
+  line += " - " + v.description;
+  console.log(line);
+}
+'
+    exit 0 ;;
+  --schema)
+    printf '%s\n' "$RECORD_SCHEMA"
+    exit 0 ;;
+esac
+
