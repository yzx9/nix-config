 #!/usr/bin/env bash
 # gstack-learnings-log — append a learning to the project learnings file
 # Usage: gstack-learnings-log '{"skill":"review","type":"pitfall","key":"n-plus-one","insight":"...","confidence":8,"source":"observed"}'
+#        gstack-learnings-log --file record.json
+#        echo '<json>' | gstack-learnings-log -
+#        gstack-learnings-log --help | --schema
 # Valid types: pattern, pitfall, preference, architecture, tool, operational, investigation
 #
 # Append-only storage. Duplicates (same key+type) are resolved at read time
 # by gstack-learnings-search ("latest winner" per key+type).
+#
+# [nix overlay — nix-config packages/gstack] Adds a self-describing record
+# schema (--help/--schema; RECORD_SCHEMA is derived from the same LEARN_*
+# enforcement constants the validator consumes, so it cannot drift),
+# --file/stdin input, and a `logged: <path>` success line. Validation rules
+# (type/key/confidence/source) are unchanged.
 set -euo pipefail
+
+# ── Self-description ─────────────────────────────────────────
+# Enforcement constants (single source of truth): both the published schema
+# and the validation step below derive from these, so the schema cannot drift
+# from what is actually enforced.
+# (unquoted expansion below is deliberate word-splitting)
+LEARN_TYPES="pattern pitfall preference architecture tool operational investigation"
+LEARN_SOURCES="observed user-stated inferred cross-model"
+LEARN_KEY_RE="^[A-Za-z0-9_-]+$"
+LEARN_CONF_MIN="1"
+LEARN_CONF_MAX="10"
+
+TYPES_JSON=$(printf '%s\n' $LEARN_TYPES | jq -R . | jq -sc .)
+SOURCES_JSON=$(printf '%s\n' $LEARN_SOURCES | jq -R . | jq -sc .)
+
+RECORD_SCHEMA=$(jq -n \
+  --argjson types "$TYPES_JSON" \
+  --argjson sources "$SOURCES_JSON" \
+  --arg keyre "$LEARN_KEY_RE" \
+  --argjson cmin "$LEARN_CONF_MIN" \
+  --argjson cmax "$LEARN_CONF_MAX" \
+  '{
+    title: "gstack-learnings-log record",
+    type: "object",
+    required: ["type", "key", "confidence"],
+    properties: {
+      type:       {type: "string",  enum: $types, description: "learning kind (enforced)"},
+      key:        {type: "string",  pattern: $keyre, description: ("short slug, " + $keyre + " only (enforced); duplicates (same key+type) resolve latest-wins at read time")},
+      confidence: {type: "integer", minimum: $cmin, maximum: $cmax, description: ("confidence, integer \($cmin)-\($cmax) (enforced; JS numeric coercion applies - \"8\" and true are accepted)")},
+      source:     {type: "string",  enum: $sources, description: "provenance (enforced when present); user-stated marks the record trusted"},
+      skill:      {type: "string",  description: "skill writing the record (conventional, not enforced)"},
+      insight:    {type: "string",  description: "the learning; instruction-like content is rejected by the injection filter"},
+      ts:         {type: "string",  description: "ISO-8601; optional - generated here when omitted or empty"},
+      files:      {type: "array",   description: "relevant file paths"}
+    }
+  }')
