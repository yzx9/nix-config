+
+# ── Self-description ─────────────────────────────────────────
+# RECORD_SCHEMA is the single authoritative record contract: --help renders it
+# human-readable, --schema prints it verbatim. Enforcement below only rejects
+# invalid JSON and re-stamps the four binding keys; "required" here reflects
+# what a meaningful record needs, not what this script hard-fails on.
+RECORD_SCHEMA='{
+  "title": "gstack-review-log record",
+  "type": "object",
+  "required": ["skill"],
+  "properties": {
+    "skill":         {"type": "string", "description": "skill writing the record"},
+    "timestamp":     {"type": "string", "description": "ISO-8601 UTC; optional - generated here when omitted or empty"},
+    "status":        {"type": "string", "description": "review outcome; free-form. Conventional values (review skill): clean | issues_found"},
+    "commit":        {"type": "string", "description": "short commit hash (git-abbreviated form); optional - derived from the stamped commit_full when omitted"},
+    "issues_found":  {"type": "number", "description": "remaining unresolved findings (informational)"},
+    "critical":      {"type": "number", "description": "remaining unresolved critical findings (informational)"},
+    "informational": {"type": "number", "description": "remaining unresolved informational findings (informational)"},
+    "quality_score": {"type": "number", "description": "PR quality score (informational)"},
+    "specialists":   {"type": ["array", "object"], "description": "per-specialist stats, an object keyed by specialist name (informational)"},
+    "findings":      {"type": ["array", "number"], "description": "per-finding records, or a count for lite flows; pass via --file/stdin - inline shell-quoting of big arrays is fragile"},
+    "source":        {"type": "string", "description": "provenance; free-form. Conventional (learnings): observed | user-stated | inferred | cross-model"},
+    "commit_full":   {"type": "string",  "description": "AUTHORITATIVE - re-stamped here; caller value ignored"},
+    "tree":          {"type": "string",  "description": "AUTHORITATIVE - HEAD tree at log time"},
+    "wtree":         {"type": "string",  "description": "AUTHORITATIVE - working-tree fingerprint (gstack-wtree)"},
+    "dirty":         {"type": "boolean", "description": "AUTHORITATIVE - tracked-file dirtiness at log time"}
